TZ=Europe/Amsterdam
APP_NAME=CargoPilot
APP_ENV=production
# Tekent de inlogtokens. CargoPilot weigert te starten zolang hier een
# gepubliceerde of te korte waarde staat. Maak er zelf een, bijvoorbeeld met:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
DATA_DIR=/data
DATABASE_URL=sqlite:////data/cargopilot.db
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=
LOG_LEVEL=INFO
# De adressen waarop je CargoPilot bereikt. '*' wordt in productie geweigerd:
# de API werkt met cookies, dus dan mag elke website namens jou verzoeken doen.
CORS_ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_PROXY_HEADERS=true
ACCESS_TOKEN_EXPIRE_MINUTES=480
CATALOG_AUTO_SYNC=true
CATALOG_SYNC_TIMEOUT_SECONDS=20
GEO_ADDRESS_API_URL=https://photon.komoot.io/api
GEO_ADDRESS_TIMEOUT_SECONDS=8
