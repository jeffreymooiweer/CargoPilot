TZ=Europe/Amsterdam
APP_NAME=CargoPilot
APP_ENV=production
# Tekent de inlogtokens. Laat leeg en CargoPilot maakt er bij de eerste start
# zelf een, die hij bewaart in DATA_DIR/secret_key en daarna blijft gebruiken.
# Vul hem alleen in als je de sleutel zelf wilt beheren, bijvoorbeeld om hem
# over meerdere instanties te delen:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
DATA_DIR=/data
DATABASE_URL=sqlite:////data/cargopilot.db
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=
LOG_LEVEL=INFO
# De adressen waarop je CargoPilot bereikt. '*' levert in productie een
# waarschuwing op: browsers weigeren dat te combineren met cookies, dus een
# aanroep vanaf een ander domein werkt dan toch niet.
CORS_ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_PROXY_HEADERS=true
# Leeg = automatisch Secure bij HTTPS of X-Forwarded-Proto=https.
# Zet alleen expliciet op false wanneer CargoPilot bewust uitsluitend via HTTP
# wordt gebruikt; true dwingt Secure ook bij een directe HTTP-aanroep af.
COOKIE_SECURE=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CATALOG_AUTO_SYNC=true
CATALOG_SYNC_TIMEOUT_SECONDS=20
GEO_ADDRESS_API_URL=https://photon.komoot.io/api
GEO_ADDRESS_TIMEOUT_SECONDS=8
